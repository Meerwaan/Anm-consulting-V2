# Copier en .env.local et remplir (jamais commiter .env.local).
# Ou, si le projet est relié à Vercel : `vercel env pull .env.local`

# --- Public (exposé au navigateur par design ; la RLS protège les données) ---
NEXT_PUBLIC_SUPABASE_URL=
# Nom actuel côté Supabase (clé sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ancien nom, encore injecté par l'intégration Vercel — l'un ou l'autre suffit
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets serveur : jamais dans le repo, jamais préfixés NEXT_PUBLIC_ ---
# Clé de service : scripts/compte.mjs, et création / retrait des accès client depuis la mission (écran Espace client).
SUPABASE_SERVICE_ROLE_KEY=
# Validité des liens « choisir son mot de passe » donnés aux clients, en minutes. Doit refléter le réglage
# Supabase « Email OTP Expiration » (Authentication > Providers > Email) : 60 par défaut, 1440 au plus.
SUPABASE_LIEN_VALIDITE_MINUTES=60
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Emails du site (src/lib/email) : clé Resend du compte où anm-consulting.fr est vérifié (droit « Sending access »).
# Sans clé, ou tant que le domaine n’est pas vérifié, aucun email ne part et le site le dit.
RESEND_API_KEY=
